{
  "name": "orc-ai-workspace",
  "version": "0.1.0",
  "description": "Local-first AI Workspace Desktop Application",
  "main": "./out/main/index.js",
  "author": "AI Workspace Team",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "node scripts/run-electron-tests.js run",
    "test:host": "vitest run"
  },
  "dependencies": {
    "@glass-sdk/liquid-glass": "^0.0.2",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@tanstack/react-virtual": "^3.11.2",
    "@xhayper/discord-rpc": "^1.5.1",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^11.8.0",
    "chokidar": "^6.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "electron": "^34.5.8",
    "electron-vite": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.19.12": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "better-sqlite3@11.10.0": true
  }
}
