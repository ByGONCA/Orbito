{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbito.dev/schemas/decision-request.schema.json",
  "title": "Orbito Architectural Decision Request Schema",
  "description": "Defines the structure for shared contract and architecture decision requests across worktree teams.",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "proposer_agent",
    "affected_worktrees",
    "date",
    "status",
    "context",
    "proposed_contract",
    "consequences"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^ADR-\\d+$"
    },
    "title": {
      "type": "string"
    },
    "proposer_agent": {
      "type": "string",
      "enum": ["backend", "frontend", "git-review", "workflows", "main"]
    },
    "affected_worktrees": {
      "type": "array",
      "items": { "type": "string" }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "UNDER_REVIEW", "ACCEPTED", "REJECTED", "SUPERSEDED"]
    },
    "context": {
      "type": "string"
    },
    "proposed_contract": {
      "type": "object",
      "properties": {
        "file_path": { "type": "string" },
        "contract_summary": { "type": "string" },
        "diff_or_schema": { "type": "string" }
      }
    },
    "consequences": {
      "type": "object",
      "properties": {
        "positive": { "type": "array", "items": { "type": "string" } },
        "negative": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
