{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbito.dev/schemas/handoff-report.schema.json",
  "title": "Orbito Worktree Team Handoff Report Specification",
  "description": "Defines required sections and metadata for formal HANDOFF.md submissions.",
  "type": "object",
  "required": [
    "task_id",
    "agent_id",
    "worktree",
    "branch",
    "submitted_at",
    "status",
    "summary",
    "subagent_executions",
    "modified_files",
    "verification_evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^ORB-[A-Z]+-\\d+$"
    },
    "agent_id": {
      "type": "string",
      "enum": ["backend", "frontend", "git-review", "workflows", "main"]
    },
    "worktree": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["READY_FOR_INTEGRATION", "PARTIAL", "BLOCKED"]
    },
    "summary": {
      "type": "string"
    },
    "subagent_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subagent_role", "summary_of_findings"],
        "properties": {
          "subagent_role": { "type": "string" },
          "summary_of_findings": { "type": "string" },
          "verification_status": { "type": "string" }
        }
      }
    },
    "modified_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_evidence": {
      "type": "object",
      "required": ["typecheck", "tests"],
      "properties": {
        "typecheck": { "type": "string" },
        "tests": { "type": "string" },
        "visual_qa": { "type": "string" },
        "coordination_validation": { "type": "string" }
      }
    }
  }
}
