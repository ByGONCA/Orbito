{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbito.dev/schemas/task-dispatch.schema.json",
  "title": "Orbito Task Dispatch Specification Schema",
  "description": "Defines the contract for task packages dispatched from MAIN to Worktree Teams and Sub-Agents.",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "assigned_agent",
    "priority",
    "status",
    "created_at",
    "updated_at",
    "objective",
    "scope",
    "dependencies",
    "expected_deliverables",
    "acceptance_criteria",
    "required_tests",
    "handoff_requirements"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^ORB-[A-Z]+-\\d+$",
      "description": "Standardized task identifier (e.g., ORB-BACK-002, ORB-FRONT-002)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "assigned_agent": {
      "type": "string",
      "enum": ["backend", "frontend", "git-review", "workflows", "main"]
    },
    "priority": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "status": {
      "type": "string",
      "enum": ["BACKLOG", "READY", "IN_PROGRESS", "BLOCKED", "REVIEW", "APPROVED", "COMPLETED", "CANCELLED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "context": {
      "type": "string"
    },
    "sub_agent_delegation": {
      "type": "object",
      "properties": {
        "recommended_specialists": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parallel_execution": { "type": "boolean" },
        "barrier_sync_required": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["allowed_files"],
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_deliverables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "mitigation": { "type": "string" }
      }
    },
    "handoff_requirements": {
      "type": "object",
      "required": ["status_file", "handoff_file", "evidence_required"],
      "properties": {
        "status_file": { "type": "string" },
        "handoff_file": { "type": "string" },
        "evidence_required": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
