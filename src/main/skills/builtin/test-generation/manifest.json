{
  "id": "test-generation",
  "name": "Test Suite Generator",
  "description": "Generates robust, production-grade unit and integration tests covering happy paths, edge cases, error conditions, and boundary values.",
  "version": "1.0.0",
  "author": "Orc AI Workspace",
  "category": "testing",
  "tags": ["test-generation", "unit-tests", "integration-tests", "vitest", "jest", "edge-cases", "mocking"],
  "supportedProviders": ["claude", "codex", "gemini"],
  "requiredCapabilities": ["context-retrieval", "ast-awareness"],
  "requiredPermissions": {
    "filesystem": {
      "read": true,
      "write": true
    },
    "terminal": {
      "execute": false
    },
    "network": {
      "allowed": false
    }
  },
  "contextRequirements": {
    "indexingNeeded": true,
    "maxContextTokens": 18000
  },
  "executionConstraints": {
    "timeoutMs": 120000,
    "maxRetries": 0
  }
}
